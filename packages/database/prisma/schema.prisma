  images           String[]
  portionSize      String?
  dietaryOptions   String[]
  specialties      String[]
  adminStatus      MealStatus @default(ACTIVE)
  adminSuspendedAt DateTime?
  adminBannedAt    DateTime?
  deletedAt        DateTime?
  vendorUpdatedAt  DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  outlet           Outlet  @relation(fields: [outletId], references: [id], onDelete: Cascade)
  cuisines         MealCuisine[]
  mealPlans        MealPlanMeal[]

  @@unique([outletId, name])
  @@index([outletId])
  @@index([adminStatus])
  @@index([deletedAt])
  @@index([createdAt])
}

model MealCuisine {
  mealId    String
  cuisineId String

  cuisine   Cuisine @relation(fields: [cuisineId], references: [id], onDelete: Cascade)
  meal      Meal    @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@id([mealId, cuisineId])
  @@index([cuisineId])
}

model MealPlan {
  id                    String     @id @default(uuid())
  outletId              String
  name                  String
  description           String?
  price                 Float?
  images                String[]
  isPublished           Boolean    @default(false)
  isFeatured            Boolean    @default(false)
  adminStatus           MealStatus @default(ACTIVE)
  adminSuspendedAt      DateTime?
  adminBannedAt         DateTime?
  deletedAt             DateTime?
  subscriptionWindowEnd DateTime?   // no new subs after this timestamp
  startsAt              DateTime?   // first delivery day
  endsAt                DateTime?   // last delivery day
  batchZones            MealPlanBatchZone[]
  subscriptions         MealPlanSubscription[]
  vendorUpdatedAt       DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  outlet                Outlet  @relation(fields: [outletId], references: [id], onDelete: Cascade)
  meals                 MealPlanMeal[]

  @@unique([outletId, name])
  @@index([outletId])
  @@index([adminStatus])
  @@index([deletedAt])
  @@index([createdAt])
}

model MealPlanMeal {
  mealPlanId  String
  mealId      String

  meal        Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  mealPlan    MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)

  @@id([mealPlanId, mealId])
  @@index([mealId])
}

 
// One record per subscriber per meal plan.
// Delivery address (lat/lng) is locked at subscription time — never changes.
// This is the source of truth for batch zone computation.
// batchZoneId is populated after the system computes zones post-window-close.
model MealPlanSubscription {
  id           String                     @id @default(uuid())
  mealPlanId   String
  consumerId   String
  batchZoneId  String?
  addressLine1 String
  addressLine2 String?
  latitude     Float
  longitude    Float
  status       MealPlanSubscriptionStatus @default(ACTIVE)
  subscribedAt DateTime                   @default(now())
  cancelledAt  DateTime?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
 
  mealPlan MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
 
  @@unique([mealPlanId, consumerId])
  @@index([mealPlanId])
  @@index([consumerId])
  @@index([batchZoneId])
  @@index([status])
}
 


//* ==================CUSTOMERS====================

model ConsumerAccount {
  id               String         @id @default(uuid())
  clerkId          String         @unique
  email            String         @unique
  fullName         String?
  phone            String?
  countryId        String?
  status           ConsumerStatus @default(ACTIVE)
  suspendedAt      DateTime?
  suspensionReason String?
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  addresses ConsumerAddress[]

  @@index([clerkId])
  @@index([email])
  @@index([status])
}

model ConsumerAddress {
  id                String   @id @default(uuid())
  consumerAccountId String
  label             String?
  addressLine1      String
  addressLine2      String?
  city              String
  postalCode        String?
  countryId         String
  latitude          Float?
  longitude         Float?
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  consumer ConsumerAccount @relation(fields: [consumerAccountId], references: [id], onDelete: Cascade)

  @@index([consumerAccountId])
  @@index([consumerAccountId, isDefault])
}


