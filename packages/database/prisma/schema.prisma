model VendorProfile {
  id                  String    @id @default(uuid())
  vendorAccountId     String    @unique
  displayName         String
  tagline             String?
  description         String?
  story               String?
  logoUrl             String?
  coverImageUrl       String?
  publicEmail         String?
  publicPhone         String?
  website             String?
  socialLinks         Json?
  reservationLink     String?
  primaryCuisineId    String?
  specialties         String[]
  dietaryOptions      String[]
  foundedYear         Int?
  totalReviews        Int       @default(0)
  averageRating       Float     @default(0)
  isVerifiedBadge     Boolean   @default(false)
  isTopRated          Boolean   @default(false)
  isCommunityFavorite Boolean   @default(false)
  isPublished         Boolean   @default(false)
  isFeatured          Boolean   @default(false)
  galleryImages       String[]
  videoUrls           String[]
  publishedAt         DateTime?

  //* Profanity/impersonation flagging — mirrors Outlet's reviewStatus/
  //* flagReasons/flaggedAt convention exactly (see runFlagChecks in
  //* vendor.outlet.service.ts). A profile can only be published while
  //* reviewStatus is AUTO_APPROVED or MANUALLY_APPROVED — see
  //* publishVendorProfile in vendor.profile.service.ts.
  reviewStatus      ProfileReviewStatus @default(AUTO_APPROVED)
  flagReasons       String[]
  flaggedAt         DateTime?
  reviewedAt        DateTime?
  reviewedByAdminId String?
  //* Set on MANUALLY_REJECTED — shown to the vendor so they know what to
  //* fix. Cleared on the next edit (recomputed flags supersede it).
  rejectionReason   String?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  primaryCuisine Cuisine?      @relation(fields: [primaryCuisineId], references: [id])
  vendorAccount  VendorAccount @relation(fields: [vendorAccountId], references: [id], onDelete: Cascade)

  @@index([vendorAccountId])
  @@index([displayName])
  @@index([primaryCuisineId])
  @@index([isPublished])
  @@index([isFeatured])
  @@index([averageRating])
  @@index([createdAt])
  @@index([totalReviews])
  @@index([reviewStatus])
}

enum ProfileReviewStatus {
  AUTO_APPROVED      // Passed all coded checks — publishable immediately
  FLAGGED            // Failed one or more coded checks — in admin queue, cannot be published
  MANUALLY_APPROVED  // Admin reviewed and cleared it — publishable
  MANUALLY_REJECTED  // Admin reviewed and rejected — cannot be published, force-unpublished if it already was
}

model VendorApplication {
  id                 String                  @id @default(uuid())
  userId             String?                 @unique
  countryId          String
  vendorTypeId       String
  otherVendorType    String?
  legalBusinessName  String?
  registrationNumber String?
  taxId              String?
  businessEmail      String?
  businessPhone      String?
  ownerFirstName     String?
  ownerLastName      String?
  ownerPhone         String?
  ownerEmail         String?
  businessAddress    String?
  addressLine2       String?
  postalCode         String?
  status             VendorApplicationStatus @default(DRAFT)
  revisionCount      Int                     @default(0)
  rejectionReason    String?
  revisionNotes      String?
  reasonCode         String?
  submittedAt        DateTime?
  reviewedAt         DateTime?
  approvedAt         DateTime?

  //* Roadmap Phase 2 (CLAUDE.md) — legal/audit trail for "did they agree
  //* to something, and which version." Set by submitApplication when the
  //* submitting client sends termsVersion (vendor-dashboard integration
  //* is a separate, later piece of work — these stay null until it sends
  //* one). Deliberately not required to submit yet — enforcing it before
  //* the client actually sends it would just break submission entirely.
  termsVersion       String?
  termsAcceptedAt    DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  //* Reviewer ownership — plain ids, not Prisma relations to AdminUser,
  //* matching this schema's existing convention for admin-actor
  //* references (see createdByAdminId on Country/City/VendorType/...).
  //* assignedReviewerId = current owner (null = unclaimed). Persists
  //* through NEEDS_REVISION -> vendor resubmit -> back to review —
  //* never cleared except by explicit reassignment.
  //* reviewedById = who performed the latest substantive review action
  //* (may differ from assignedReviewerId after a reassignment).
  assignedReviewerId String?
  assignedAt         DateTime?
  reviewedById       String?

  //* Escalation — a permanent, non-clearing marker (unlike assignedReviewerId,
  //* which reassignment happily overwrites). escalatedByAdminId is the one
  //* fact that must survive every future claim/reassign: the escalating
  //* admin is locked out of acting on this application again, forever, by
  //* assertReviewerOwnership. A null assignedReviewerId alongside a set
  //* escalatedByAdminId means "open pool" — only admins holding
  //* vendors:applications:receive_escalation may claim it from there,
  //* instead of the normal "anyone with review" rule for unclaimed apps.
  escalatedByAdminId String?
  escalatedAt        DateTime?
  escalationReason   String?

  vendorAccount VendorAccount? @relation("ApplicationToAccount")
  country       Country        @relation(fields: [countryId], references: [id])
  user          VendorUser?    @relation(fields: [userId], references: [id])
  vendorType    VendorType     @relation(fields: [vendorTypeId], references: [id])
  documents     VendorDocument[]
  appeals       VendorAppeal[]

  @@index([status])
  @@index([countryId])
  @@index([assignedReviewerId, status])
}

//* Roadmap VM-P1-04 (CLAUDE.md) — admin-side log/track/resolve of a
//* formal appeal against an adverse vendor decision (a rejected
//* application, an account suspension, or a ban). Vendor self-service
//* submission is deferred to the vendor-dashboard phase — every row here
//* is logged by an admin who received the appeal through another channel
//* (email, support ticket, etc.), same "record what happened" spirit as
//* VendorComplianceCase, but deliberately simpler: no claim-race lockout,
//* no escalation pool — appeal volume doesn't justify that machinery, and
//* the roadmap explicitly calls for the simplest workable model.
//*
//* Exactly one of applicationId/vendorId is set, matching subjectType —
//* same "one row, two possible anchors" convention as VendorDocument,
//* needed because a rejected VendorApplication never becomes a
//* VendorAccount, so there's no single FK that covers all three subject
//* types.
//*
//* Deliberately does NOT auto-reverse the underlying decision when
//* resolved OVERTURNED — reinstating a suspended account or unbanning a
//* vendor stays a separate, deliberate action via the existing
//* reinstateVendor/unbanVendor flows (same "human decision via the
//* existing action" pattern as compliance issues never auto-suspending).
//* Overturning a rejected APPLICATION currently has no reversal action
//* at all yet (no reopen-a-rejected-application transition exists in
//* admin.vendor.service.ts) — a known, documented gap, not silently
//* built around here.
model VendorAppeal {
  id            String            @id @default(uuid())
  applicationId String?
  vendorId      String?
  subjectType   AppealSubjectType
  reason        String
  status        AppealStatus      @default(OPEN)

  assignedReviewerId String?
  assignedAt         DateTime?

  resolvedAt         DateTime?
  resolvedByAdminId  String?
  resolutionNote     String?

  //* Who logged this appeal — always an admin, since vendor self-service
  //* submission doesn't exist yet (see model comment above).
  createdByAdminId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application VendorApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  vendor      VendorAccount?     @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([vendorId])
  @@index([status])
  @@index([assignedReviewerId, status])
}

enum AppealSubjectType {
  APPLICATION_REJECTION
  ACCOUNT_SUSPENSION
  ACCOUNT_BAN
}

enum AppealStatus {
  OPEN
  UNDER_REVIEW
  UPHELD
  OVERTURNED
}

