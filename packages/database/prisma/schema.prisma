generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//* ==============ADMIN INFRASTRUCTURE====================

model AdminUser {
  id                  String    @id @default(uuid())
  clerkUserId         String?   @unique
  roleId              String?
  email               String    @unique
  firstName           String
  middleName          String?
  lastName            String
  employeeId          String?   @unique
  status              AdminUserStatus @default(pending)
  invitationExpiresAt DateTime?
  isActive            Boolean    @default(false)
  invitedById         String?
  invitationSentCount Int        @default(0)
  invitationSentAt    DateTime?
  lastSeenAt          DateTime?
  deactivatedAt       DateTime?
  deactivationReason  String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  reviewAvailability  AdminReviewAvailability @default(AVAILABLE)
  unavailableFrom     DateTime?
  unavailableUntil    DateTime?
  unavailableReason   String?

  role                AdminRole?      @relation(fields: [roleId], references: [id])
  invitedBy           AdminUser?      @relation("AdminInvitedBy", fields: [invitedById], references: [id])
  invitees            AdminUser[]     @relation("AdminInvitedBy")
  scopes              AdminUserScope[]
  permissions         AdminUserPermission[] @relation("UserPermissions")
  granted             AdminUserPermission[] @relation("PermissionGrantedBy")
  auditLogs           AuditLog[]
  notifications       AdminNotification[]

  @@index([clerkUserId])
  @@index([roleId])
  @@index([status])
  @@index([email])
  @@index([reviewAvailability])
}

enum AdminReviewAvailability {
  AVAILABLE
  UNAVAILABLE
}

//* Admin-facing in-app notification center — the AdminUser counterpart to
//* VendorNotification. Starts with one type (a stale-unclaimed compliance
//* case nudge, see compliance-case-sync.job.ts); metadata carries enough
//* to deep-link (e.g. vendorId/documentTypeId) without needing per-type
//* columns. Deliberately no email/push here — this is the in-app-only
//* notification the user asked for; email escalation for admins, if ever
//* needed, is a separate future decision, not assumed here.
model AdminNotification {
  id          String                @id @default(uuid())
  adminUserId String
  type        AdminNotificationType
  title       String
  message     String
  metadata    Json?
  isRead      Boolean               @default(false)
  readAt      DateTime?
  createdAt   DateTime              @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([adminUserId, isRead])
  @@index([createdAt])
}

enum AdminNotificationType {
  COMPLIANCE_CASE_STALE
}

model AdminRole {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  description String?
  createdAt   DateTime @default(now())

  users       AdminUser[]
  permissions AdminRolePermission[]
}

model AdminPermission {
  id          String   @id @default(uuid())
  key         String   @unique
  module      String
  description String?
  isActive    Boolean  @default(true)

  roles AdminRolePermission[]
  users AdminUserPermission[]
}

model AdminRolePermission {
  roleId        String
  permissionId  String

  role          AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model AdminUserPermission {
  id           String   @id @default(uuid())
  adminUserId  String
  permissionId String
  grantedById  String
  grantedAt    DateTime @default(now())

  adminUser    AdminUser       @relation("UserPermissions", fields: [adminUserId], references: [id], onDelete: Cascade)
  permission   AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedBy    AdminUser       @relation("PermissionGrantedBy", fields: [grantedById], references: [id])

  @@unique([adminUserId, permissionId])
  @@index([adminUserId])
  @@index([permissionId])
}

///* Geographic scope for an admin user.
/// scopeType = GLOBAL  → countryId and cityId are null
/// scopeType = COUNTRY → countryId set, cityId null
/// scopeType = CITY    → both set
///
///* Valid scope types per role (enforced at service layer):
///   super_admin     → GLOBAL only
///   identity_admin  → COUNTRY or GLOBAL (GLOBAL requires super_admin grant)
///   finance         → COUNTRY
///   vendor_ops      → COUNTRY or CITY
///   customer_care   → CITY or COUNTRY (city preferred)
///   courier_ops     → CITY only
///   operations_admin→ GLOBAL only (temporary — every market shares the same launch process for now)
model AdminUserScope {
  id          String         @id @default(uuid())
  adminUserId String
  scopeType   AdminScopeType
  countryId   String?
  cityId      String?

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  country   Country?  @relation(fields: [countryId], references: [id])
  city      City?     @relation(fields: [cityId], references: [id])

  @@unique([adminUserId, scopeType, countryId, cityId])
  @@index([adminUserId])
  @@index([countryId])
  @@index([cityId])
}

//* Append-only audit log across all models. Written asynchronously — never blocks a request.

model AuditLog {
  id          String    @id @default(uuid())
  adminUserId String?
  action      String
  entityType  String
  entityId    String?
  changes     Json?
  metadata    Json?
  createdAt   DateTime  @default(now())

  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

//* Long-term audit record storage.
/* Records are moved here from AuditLog after AUDIT_HOT_DAYS (90 days) 
/// by the monthly audit-archive cron job.
/// Not shown in admin UI by default — accessible via export or direct query.
/// Deleted after AUDIT_DELETE_DAYS (730 days) by the same job.
*/
model AuditLogArchive {
  id          String   @id @default(uuid())
  adminUserId String
  action      String
  entityType  String
  entityId    String?
  changes     Json?
  metadata    Json?
  createdAt   DateTime
  archivedAt  DateTime @default(now())

  @@index([adminUserId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([archivedAt])
}


/// Predefined reasons for standard admin actions.
/// Selected by admin when taking an action — stored in AuditLog.metadata.reasonCode.
///
/// countryId null = global reason, available to every country.
/// countryId set  = country-specific override/addition for that code.
/// Resolution (see resolveActionReason): try [code, countryId] first,
/// fall back to [code, null]. Same optional-narrower-scope pattern as
/// DocumentTypeConfig's countryId/cityId — country-specific config is
/// additive, not mandatory per country.
model AdminActionReason {
  id          String   @id @default(uuid())
  code        String
  label       String
  description String?
  appliesTo   String[]
  countryId   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([code, countryId])
  @@index([isActive])
  @@index([countryId])
}

/// Pre-computed summary metrics. Refreshed every 5 minutes by a background job.
model DashboardStat {
  key       String   @id
  value     Decimal  @db.Decimal(20, 4)
  updatedAt DateTime @updatedAt
  metadata  Json?
}


//* =========GEOGRAPHY & CONFIGURATION=============


model Region {
  id          String        @id  @default(uuid())
  name        String        @unique   // "East Africa", "West Africa"
  slug        String        @unique   // "east-africa", "west-africa"
  code        String        @unique   // "EAF", "WAF", "SAF" — short display code
  description String?
  status      GeoStatus     @default(ACTIVE)
  createdByAdminId String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  countries   Country[]

  @@index([status])
  @@index([slug])
}

model Country {
  id                 String    @id @default(uuid())
  name               String    @unique
  code               String    @unique
  slug               String    @unique
  //* Legacy plain-string ISO code — retained for compatibility during the
  //* finance migration. New code should read `currencyCode` / `currencyRef`.
  currency           String
  currencySymbol     String?
  //* Finance Phase 1A — FK into the Currency reference table. Nullable
  //* while backfilling; the seed sets it for every country whose `currency`
  //* matches a seeded Currency row. Becomes the source of truth (and
  //* `currency` is dropped) in a later phase.
  currencyCode       String?
  currencyRef        Currency? @relation(fields: [currencyCode], references: [code])
  phoneCode          String
  timezones          String[]
  regionId           String?
  region             Region?   @relation(fields: [regionId], references: [id])
  status             GeoStatus @default(ACTIVE)
  createdByAdminId   String?
  createdAt          DateTime  @default(now())

  //* Go-live milestones, independent of `status`. Being ACTIVE means "we
  //* operate here" — it does NOT mean vendors can onboard or that customers
  //* should be advertised to yet. These flags cover the setup window
  //* (hiring, shop setup) between activation and actually opening up.
  //* readyForCustomerOperations is expected to only ever be set after
  //* readyForVendorOnboarding (enforced at the service layer, not here).
  readyForVendorOnboarding    Boolean   @default(false)
  vendorOnboardingReadyAt     DateTime?
  vendorOnboardingReadyById   String?
  readyForCustomerOperations  Boolean   @default(false)
  customerOperationsReadyAt   DateTime?
  customerOperationsReadyById String?

  cities             City[]
  documentTypes      DocumentTypeConfig[]
  vendors            VendorAccount[]
  vendorApplications VendorApplication[]
  vendorTypes        VendorTypeCountry[]
  adminScopes        AdminUserScope[]

  //* Finance Phase 1B — a country's financial operating configuration
  //* (1:1) and its provider-account wiring (1:N, only one ACTIVE).
  financialConfig    CountryFinancialConfig?
  providerAccounts   CountryProviderAccount[]

  @@index([status])
  @@index([slug])
  @@index([regionId])
  @@index([currencyCode])
}

model City {
  id               String    @id @default(uuid())
  countryId        String
  name             String
  code             String?   @unique // system-generated, e.g. "NAIROBI_KENYA" — see admin.city.service.ts
  slug             String    @unique
  timezone         String
  latitude         Float?            // centroid — Mapbox fly-to only
  longitude        Float?            // centroid — Mapbox fly-to only
  status           GeoStatus @default(ACTIVE)
  createdByAdminId String?

  //* Deactivation audit trail — mirrors VendorAccount's suspensionReason/
  //* suspendedAt convention. Cleared back to null on reactivation.
  deactivatedByAdminId String?
  deactivatedAt         DateTime?
  deactivationReason    String?

  boundary         Json?     // GeoJSON Polygon | MultiPolygon — city operational boundary
  boundingBox      Json?     // { north, south, east, west }   — derived cache, never manual
  osmId            String?   // OSM relation ID (numeric string) stored after OSM search
  boundarySource   String?   // "OSM" | "MANUAL"
  boundarySetAt    DateTime?
  boundarySetById  String?
 
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
 
  country          Country              @relation(fields: [countryId], references: [id])
  documentTypes    DocumentTypeConfig[]
  serviceAreas     ServiceArea[]
  deliveryZones    DeliveryZone[]
  adminScopes      AdminUserScope[]
 
  @@unique([countryId, name])
  @@index([countryId])
  @@index([status])
  @@index([slug])
}


// Added: mode ServiceAreaMode — what level of service applies in this polygon.
//
// All four modes are stored as distinct ServiceArea records.
// The admin draws a polygon and assigns it a mode — all on the same page.
// EXCLUDED areas are stored but never returned by vendor/customer APIs.
//
// Any outlet location inside the city boundary but not covered by any
// ServiceArea polygon is treated as WAITLIST by the resolver (not UNZONED).
 
model ServiceArea {
  id               String          @id @default(uuid())
  cityId           String
  name             String
  boundaries       Json            // GeoJSON Polygon | MultiPolygon
  mode             ServiceAreaMode @default(WAITLIST)
  status           GeoStatus       @default(ACTIVE)
  createdByAdminId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
 
  city    City                @relation(fields: [cityId], references: [id], onDelete: Cascade)
  outlets OutletServiceArea[]
 
  @@unique([cityId, name])
  @@index([cityId])
  @@index([status])
  @@index([mode])
}


// Permanent logistics zones — drawn by courier_ops on a SEPARATE admin page.
// Only valid inside FULL_SERVICE areas.
// No overlaps allowed within a city (backend warns, does not block).

model DeliveryZone {
  id               String    @id @default(uuid())
  cityId           String
  name             String
  boundaries       Json      // GeoJSON Polygon | MultiPolygon
  status           GeoStatus @default(ACTIVE)
  maxCourierCount  Int?
  createdByAdminId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
 
  city       City                @relation(fields: [cityId], references: [id], onDelete: Cascade)
  batchZones MealPlanBatchZone[]
 
  @@unique([cityId, name])
  @@index([cityId])
  @@index([status])
}


// Ephemeral zone — computed ONCE after subscription window closes.
// Groups geographically close subscribers of a single meal plan.
// The same courier covers this zone for the ENTIRE meal plan lifecycle,
// delivering a different meal each day in the same time window.
// Individual daily delivery records are tracked elsewhere (order/delivery layer).
model MealPlanBatchZone {
  id             String          @id @default(uuid())
  code           String          @unique  // auto-generated: "MP-{planId[:8]}-Z{n}"
  mealPlanId     String
  deliveryZoneId String?         // nearest permanent zone — nullable, reference only
  cityId         String          // denormalised for queries
  boundaries     Json            // GeoJSON Polygon — convex hull of subscriber cluster
  windowStart    String          // "18:00" HH:MM — same every delivery day
  windowEnd      String          // "19:00" HH:MM
  subscriberCount Int            @default(0)
  status         BatchZoneStatus @default(PENDING)
  computedAt     DateTime        @default(now())
  assignedAt     DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
 
  mealPlan     MealPlan      @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  deliveryZone DeliveryZone? @relation(fields: [deliveryZoneId], references: [id])
 
  @@index([mealPlanId])
  @@index([deliveryZoneId])
  @@index([cityId])
  @@index([status])
}



model OutletServiceArea {
  outletId      String
  serviceAreaId String
 
  outlet      Outlet      @relation(fields: [outletId], references: [id], onDelete: Cascade)
  serviceArea ServiceArea @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)
 
  @@id([outletId, serviceAreaId])
  @@index([serviceAreaId])
}

//* =========FINANCE FOUNDATION (Phase 1A + 1B)==========
//* Platform-level financial reference data + per-country financial
//* configuration. DailyBread owns the financial source of truth; payment
//* providers (Flutterwave/Stripe/…) are rails. See
//* apps/backend/src/modules/finance. Phase 1A: Currency + PaymentProvider
//* catalog. Phase 1B: CountryFinancialConfig + CountryProviderAccount.
//* Still deliberately NOT here: ledger / payments / payouts / settlement /
//* reconciliation — later phases.

//* ISO-4217 currency reference. Exists so the financial domain never
//* treats currency as an arbitrary string — an amount is always
//* (integer minor units + a currency that resolves here). `code` is the
//* natural key (e.g. "KES", "USD"). Country.currency (a plain string) is
//* kept during migration; Country.currencyCode is the new FK.
model Currency {
  code            String                 @id            // ISO-4217, uppercase
  name            String                                // "Kenyan Shilling"
  symbol          String?                               // "KSh"
  //* Number of decimal places the currency's minor unit uses — 2 for most
  //* (KES/USD/EUR), 0 for JPY/UGX-style, 3 for BHD/KWD. Drives how an
  //* amountMinor integer maps to a human-facing value; never assumed to be 2.
  minorUnitDigits Int                    @default(2)
  status          FinanceReferenceStatus @default(ACTIVE)
  createdByAdminId String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  countries        Country[]
  financialConfigs CountryFinancialConfig[]

  @@index([status])
}

//* Platform catalog of payment-provider IMPLEMENTATIONS the system knows
//* how to talk to (Flutterwave, Stripe, …). This is NOT provider
//* credentials and NOT a per-country wiring — it only declares what a
//* provider IS and what it CAN do. Credentials stay outside the DB
//* (see ProviderSecretsResolver); per-country wiring
//* (CountryProviderAccount) is a later phase. `capabilities` is the
//* declared capability set the future adapter is expected to implement —
//* a country can only enable a financial operation whose provider
//* declares the matching capability here.
model PaymentProvider {
  id                  String                      @id @default(uuid())
  code                String                      @unique   // "FLUTTERWAVE", "STRIPE"
  name                String
  status              FinanceReferenceStatus      @default(ACTIVE)
  capabilities        PaymentProviderCapability[]            // declared; empty = nothing enabled
  //* Which PaymentMethod.type values this provider can handle at all —
  //* kept coherent with `capabilities` at the service layer
  //* (validateProviderCapabilityCoherence).
  methodTypes         PaymentMethodType[]
  //* ISO-4217 codes the provider supports; empty = unrestricted / not yet declared.
  supportedCurrencies String[]
  description         String?
  createdByAdminId    String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  countryAccounts     CountryProviderAccount[]

  @@index([status])
}

//* A configured provider account belonging to one country. This is the
//* "Kenya uses THIS Flutterwave account, in THIS environment" layer —
//* distinct from PaymentProvider ("Flutterwave exists") and from
//* CountryFinancialConfig ("Kenya's financial settings").
//*
//* Append-only by policy: never hard-deleted (historical financial
//* records will attribute to a specific account id) — retired via
//* status = DISABLED only. A country may have many; at most ONE may be
//* ACTIVE at a time (enforced in the service layer inside a transaction —
//* Prisma has no partial-unique-index support).
//*
//* Secrets (API keys, webhook signing secrets) are NEVER stored here.
//* `secretAlias` is a non-secret pointer resolved by ProviderSecretsResolver.
model CountryProviderAccount {
  id                  String                       @id @default(uuid())
  countryId           String
  paymentProviderId   String
  environment         PaymentEnvironment
  //* Non-secret reference, e.g. "flutterwave_ke_primary". The actual
  //* credentials live outside the DB (env / secret manager).
  secretAlias         String
  //* Which of the provider's declared capabilities this account turns on
  //* for this country. MUST be a subset of PaymentProvider.capabilities
  //* (validateProviderCapabilityCoherence + assertEnabledSubsetOfProvider).
  enabledCapabilities PaymentProviderCapability[]
  accountLabel        String?
  //* The provider's own merchant/account identifier — a non-secret id used
  //* for reconciliation, safe to store.
  externalAccountId   String?
  status              CountryProviderAccountStatus @default(DRAFT)

  activatedAt         DateTime?
  activatedByAdminId  String?
  suspendedAt         DateTime?
  suspendedByAdminId  String?
  suspensionReason    String?
  disabledAt          DateTime?
  disabledByAdminId   String?

  createdByAdminId    String?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  country             Country                      @relation(fields: [countryId], references: [id], onDelete: Cascade)
  paymentProvider     PaymentProvider              @relation(fields: [paymentProviderId], references: [id])
  activeForConfig     CountryFinancialConfig?      @relation("ActiveProviderAccount")

  @@index([countryId, status])
  @@index([paymentProviderId])
  @@index([status])
}

//* A country's financial operating configuration (1:1 with Country).
//* One mutable row — NOT versioned; historical attribution is preserved
//* by transactions snapshotting the CountryProviderAccount id + currency
//* they occurred under, and by provider accounts never being deleted.
//*
//* "Config row exists" != "country is financially operational". Operational
//* requires status = ACTIVE, an ACTIVE activeProviderAccount, an ACTIVE
//* currency, the relevant enabled switch, and a matching CountryPaymentMethod
//* — see the readiness predicates in finance.readiness.service.ts.
//*
//* V1: a single activeProviderAccountId serves BOTH collection and payout
//* (approved decision). Split into separate fields later if needed.
model CountryFinancialConfig {
  id                      String                        @id @default(uuid())
  countryId               String                        @unique
  currencyCode            String?
  activeProviderAccountId  String?                       @unique
  //* Operational switches — the admin's deliberate "we are collecting /
  //* paying out here" decision, distinct from "the provider can technically
  //* do it". Mutable while ACTIVE (validated + audited).
  collectionsEnabled      Boolean                       @default(false)
  payoutsEnabled          Boolean                       @default(false)
  status                  CountryFinancialConfigStatus  @default(DRAFT)

  activatedAt             DateTime?
  activatedByAdminId      String?
  suspendedAt             DateTime?
  suspendedByAdminId      String?
  suspensionReason        String?
  disabledAt             DateTime?
  disabledByAdminId       String?

  createdByAdminId        String?
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt

  country                 Country                       @relation(fields: [countryId], references: [id], onDelete: Cascade)
  currency                Currency?                     @relation(fields: [currencyCode], references: [code])
  activeProviderAccount   CountryProviderAccount?       @relation("ActiveProviderAccount", fields: [activeProviderAccountId], references: [id])

  @@index([status])
  @@index([currencyCode])
}

//* =========PAYMENT CONFIGURATION==========

model PaymentMethod {
  id               String            @id @default(uuid())
  code             String            @unique  // "MPESA", "BANK_TRANSFER", "PAYPAL", "AIRTEL_MONEY"
  name             String          
  type             PaymentMethodType   // MOBILE_MONEY | BANK | DIGITAL_WALLET | CARD
  direction        PaymentDirection[]  // [INBOUND, OUTBOUND] — can it collect? can it pay out?
  logoUrl          String?
  description      String?
  createdByAdminId String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())

  countryConfigs CountryPaymentMethod[]
}

model CountryPaymentMethod {
  id                String     @id @default(uuid())
  countryId         String
  paymentMethodId   String
  direction         PaymentDirection     // INBOUND or OUTBOUND
  status            CountryPaymentMethodStatus   @default(ACTIVE)
  
  // Our own collection/disbursement account details for this method in this country
  // Stored as JSON because M-Pesa needs a paybill, bank needs account+branch, PayPal needs email
  ourAccountDetails     Json?
  
  // Verification provider config for vendor account validation
  verificationProvider  String?   // "AFRICASTALKING", "SAFARICOM_DARAJA", "MANUAL"
  verificationConfig    Json?     // provider-specific config, API keys stored in env but config here
  displayOrder          Int       @default(0)

  createdByAdminId      String?
  createdAt             DateTime  @default(now())

  paymentMethod         PaymentMethod  @relation(fields: [paymentMethodId], references: [id])
  vendorPayoutAccounts  VendorPayoutAccount[]

  @@unique([countryId, paymentMethodId, direction])
  @@index([countryId])
  @@index([paymentMethodId])
  @@index([status])
}

model VendorCommissionConfig {
  id               String   @id @default(uuid())
  countryId        String   @unique   // country-level default
  rate             Float               // 0.15 = 15%
  effectiveFrom    DateTime @default(now())
  createdByAdminId String?
  createdAt        DateTime @default(now())

  @@index([countryId])
}

//* ==========VENDORS==============

model VendorType {
  id               String           @id @default(uuid())
  name             String           @unique
  slug             String           @unique
  description      String?
  status           VendorTypeStatus @default(ACTIVE)
  createdByAdminId String?
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())

  documentTypeConfigs DocumentTypeVendorType[]
  vendorAccounts      VendorAccount[]
  vendorApplications  VendorApplication[]
  countries           VendorTypeCountry[]

  @@index([status])
}

model VendorTypeCountry {
  id               String    @id @default(uuid())
  countryId        String
  vendorTypeId     String
  status           GeoStatus @default(ACTIVE)
  createdByAdminId String?
  createdAt        DateTime  @default(now())

  country    Country    @relation(fields: [countryId], references: [id])
  vendorType VendorType @relation(fields: [vendorTypeId], references: [id])

  @@unique([countryId, vendorTypeId])
  @@index([countryId])
  @@index([vendorTypeId])
  @@index([status])
}

model DocumentTypeConfig {
  id                String             @id @default(uuid())
  name              String
  code              String
  description       String?
  scope             DocumentScope
  isInheritable     Boolean            @default(false)
  countryId         String
  cityId            String?
  isRequired        Boolean            @default(true)
  requiresExpiry    Boolean            @default(true)
  expiryWarningDays Int                @default(30)
  //* Compliance framework (phase 2) — see admin.vendor.compliance.service.ts.
  //* complianceSeverity: how urgent an issue on this document type is,
  //* shown/sorted on /vendors/compliance — purely informational today, no
  //* automatic enforcement reads it yet.
  //* gracePeriodDays: tolerance window after expiryDate before an expired
  //* document counts as a hard EXPIRED issue instead of the softer
  //* "in grace period" state.
  //* enforcedFrom: when set, a vendor missing this (now-required) document
  //* only becomes a MISSING compliance issue once this date has passed —
  //* lets a newly-added requirement roll out with a transition window
  //* instead of instantly flagging every existing vendor. Null = enforced
  //* immediately (the default for a type with no rollout need).
  complianceSeverity DocumentComplianceSeverity @default(MEDIUM)
  gracePeriodDays    Int                         @default(0)
  enforcedFrom       DateTime?
  instructions      String?
  sampleUrl         String?
  status            DocumentTypeStatus @default(ACTIVE)
  createdByAdminId  String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  //* Deactivation audit trail — mirrors VendorAccount's suspensionReason/
  //* suspendedAt convention. Cleared back to null on reactivation.
  deactivatedByAdminId String?
  deactivatedAt         DateTime?
  deactivationReason    String?

  city              City?                       @relation(fields: [cityId], references: [id], onDelete: Cascade)
  country           Country                     @relation(fields: [countryId], references: [id], onDelete: Cascade)
  vendorTypeConfigs DocumentTypeVendorType[]
  storeDocuments    OutletDocument[]
  storeInheritances OutletDocumentInheritance[]
  vendorDocuments   VendorDocument[]
  complianceWaivers VendorComplianceWaiver[]
  complianceCases   VendorComplianceCase[]

  @@unique([code, countryId, cityId])
  @@index([countryId])
  @@index([cityId])
  @@index([scope, countryId, cityId])
}

model DocumentTypeVendorType {
  id             String             @id @default(uuid())
  documentTypeId String
  vendorTypeId   String
  isRequired     Boolean            @default(true)
  createdAt      DateTime           @default(now())

  documentType DocumentTypeConfig @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  vendorType   VendorType         @relation(fields: [vendorTypeId], references: [id], onDelete: Cascade)

  @@unique([documentTypeId, vendorTypeId])
  @@index([documentTypeId])
  @@index([vendorTypeId])
}

//* Compliance framework (phase 3) — an admin-granted exception that
//* suppresses one vendor+documentType compliance issue (of any kind —
//* MISSING, EXPIRED, EXPIRING_SOON) from counting toward "open issues"
//* until it expires, without faking the underlying document as approved.
//* Vendor-scoped only for now (VendorComplianceWaiver, not a generic
//* polymorphic waiver) — when outlet administration is built, an
//* analogous OutletComplianceWaiver is the expected shape, not a
//* migration of this model; see CLAUDE.md's compliance section.
model VendorComplianceWaiver {
  id               String    @id @default(uuid())
  vendorId         String
  documentTypeId   String
  reason           String
  expiresAt        DateTime
  grantedByAdminId String

  //* Revocation, not deletion — an admin can end a waiver early, but the
  //* record (and who granted it) stays in the audit trail.
  revokedAt        DateTime?
  revokedByAdminId String?
  revokedReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor       VendorAccount      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  documentType DocumentTypeConfig @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([documentTypeId])
  @@index([expiresAt])
}

//* Compliance case workflow (phase "claim/escalate", 2026-08-25) — a
//* persistent, claimable/escalatable record of one open compliance issue,
//* modeled deliberately close to VendorApplication's review workflow
//* (assignedReviewerId/escalatedByAdminId/escalationReason) so the two
//* feel like siblings, not two different systems. Distinct from
//* VendorComplianceWaiver (an exception on the underlying issue) — a case
//* can be OPEN/CLAIMED/ESCALATED while a waiver is separately granted or
//* not; when it is, the case moves to WAIVED too (see
//* admin.vendor.compliance-case.service.ts).
//*
//* Kept in sync with live detection (getComplianceOverview's candidate
//* list) by a periodic reconciliation job
//* (jobs/vendor/compliance-case-sync.job.ts), not synchronously on every
//* read — same "detect on a schedule, not instantly" philosophy as the
//* document-expiry cron. A case for an issue that no longer exists (the
//* vendor fixed it) is auto-marked RESOLVED by that same job.
model VendorComplianceCase {
  id             String               @id @default(uuid())
  vendorId       String
  documentTypeId String
  issueType      ComplianceIssueKind
  //* Snapshotted from DocumentTypeConfig.complianceSeverity at case-open
  //* time — a later severity edit on the document type shouldn't silently
  //* rewrite the urgency of a case already being worked.
  severity       DocumentComplianceSeverity
  status         ComplianceCaseStatus @default(OPEN)

  assignedReviewerId String?
  assignedAt         DateTime?

  //* Escalation — permanent, non-clearing marker, same convention as
  //* VendorApplication.escalatedByAdminId: the escalating admin is locked
  //* out of claiming this case again. Claimable from the open-escalation
  //* pool only by holders of VENDORS_COMPLIANCE_RECEIVE_ESCALATION who are
  //* ALSO country-scoped to the vendor's own country — deliberately
  //* excludes globally-scoped admins, unlike the applications escalation
  //* pool (see claimEscalatedComplianceCase). Compliance follow-up stays
  //* with the local country team.
  escalatedByAdminId String?
  escalatedAt        DateTime?
  escalationReason   String?

  //* Roadmap "compliance case workflow refinement" (CLAUDE.md) — true only
  //* while the CURRENT assignment was obtained by self-service claiming
  //* out of the open escalation pool (claimComplianceCase's escalation
  //* branch). Distinct from escalatedByAdminId (which is permanent and
  //* tracks WHO escalated, for their own lock-out) — this tracks HOW the
  //* current holder got it, and gates whether THEY may escalate again:
  //* a self-service escalation claim is terminal (must resolve directly),
  //* but a reassignment (even one that lands on the same admin, or one
  //* that hands an already-escalated case to someone new) resets this to
  //* false, since reassignment is a deliberate supervisory hand-off, not
  //* the admin opting into being the end of the line.
  claimedFromEscalation Boolean @default(false)

  resolvedAt        DateTime?
  resolvedByAdminId String?
  resolutionNote     String?

  notifiedCount  Int       @default(0)
  lastNotifiedAt DateTime?

  //* Set once the 24h-unclaimed stale alert has fired for this case (see
  //* COMPLIANCE_CASE_STALE_NOTIFY_HOURS, compliance-case-sync.job.ts) —
  //* prevents re-notifying every cron run. Independent of the separate
  //* 7-day auto-escalation threshold (COMPLIANCE_CASE_STALE_DAYS) — this
  //* is a softer, earlier nudge to designated staff, not an escalation.
  staleNotifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor       VendorAccount      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  documentType DocumentTypeConfig @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([documentTypeId])
  @@index([status])
  @@index([assignedReviewerId, status])
  @@index([escalatedByAdminId, status])
}

//* Vendor-facing notifications (compliance for now — deliberately generic
//* enough to carry other types later). Backend-only for this pass: writes
//* here, plus the vendor-facing read/list route, exist so the data is
//* ready the moment vendor-dashboard work picks this up — no
//* vendor-dashboard UI reads it yet (see CLAUDE.md).
model VendorNotification {
  id        String                 @id @default(uuid())
  vendorId  String
  type      VendorNotificationType
  title     String
  message   String
  metadata  Json?
  isRead    Boolean                @default(false)
  readAt    DateTime?
  createdAt DateTime               @default(now())

  vendor VendorAccount @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([vendorId, isRead])
  @@index([createdAt])
}

//* Roadmap Phase 2 (CLAUDE.md) — VendorAccount.commissionRate was a
//* mutable field with no admin action to change it and no record of what
//* it was when. This is that record; admin.vendor.commission.service.ts
//* is what actually writes both this and the live commissionRate together.
model VendorCommissionRateHistory {
  id               String   @id @default(uuid())
  vendorId         String
  previousRate     Float?
  newRate          Float
  reason           String?
  changedByAdminId String
  createdAt        DateTime @default(now())

  vendor VendorAccount @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([createdAt])
}

model VendorUser {
